-
-    hdr = (struct wvm_header *)buffer;
-    memset(hdr, 0, sizeof(*hdr));
-    hdr->magic = htonl(WVM_MAGIC);
-    hdr->msg_type = htons(msg_type);
-    hdr->payload_len = htons(len);
