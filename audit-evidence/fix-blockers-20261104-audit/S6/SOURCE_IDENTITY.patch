+            for (size_t i = 0; i < prepared.candidate.vcpu_placements.count; i++) {
+                if (prepared.candidate.vcpu_placements.entries[i].executor_physical_node_id != 17) {
+                    snprintf(error, sizeof(error), "vCPU placed on non-KVM node");
+                    goto out;
+                }
