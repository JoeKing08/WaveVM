-        radix_tree_lookup(&context->page_tree, gpa >> PAGE_SHIFT);
-    
-    if (meta && meta->page) {
-        // [FIX] 幂等性检查：如果包版本 <= 本地版本，静默丢弃
-        // 内核态也必须防御重放攻击或网络乱序
