+    pthread_mutex_lock(&service->cache_lock);
+    entry = cache_slot_locked(service, gpa);
+    if (entry && version >= entry->version) {
+        entry->version = version;
+        entry->valid = 1;
+        entry->resync_in_flight = 0;
+    }
+    pthread_mutex_unlock(&service->cache_lock);
+}
