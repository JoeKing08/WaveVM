+static int request_page_resync(struct wvm_memory_service *service,
+                               uint64_t gpa, uint64_t version,
+                               const uint8_t source_operation_id[
+                                   WVM_IDENTITY_ID_BYTES],
+                               char *error, size_t error_len)
+{
