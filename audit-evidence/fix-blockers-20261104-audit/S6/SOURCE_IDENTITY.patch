-            if (flags & WVM_FLAG_ZERO) {
-                memset(vaddr, 0, 4096);
-            } else if (data_len > 0) {
-                memcpy((uint8_t*)vaddr + offset, data_ptr, data_len);
-            }
-            kunmap_atomic(vaddr);
