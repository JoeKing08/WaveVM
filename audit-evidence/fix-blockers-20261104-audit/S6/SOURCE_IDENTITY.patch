-                                     uint64_t gpa) {
-    spin_lock(&context->page_tree_lock);
-    kvm_page_meta_t *meta =
-        radix_tree_delete(&context->page_tree, gpa >> PAGE_SHIFT);
-    spin_unlock(&context->page_tree_lock);
-    
-    if (meta) {
-        // 必须释放队列中所有积压的 skb，否则内存泄漏
-        skb_queue_purge(&meta->reorder_q);
-        
-        // 等待所有 RCU 读者读完后释放结构体
-        kfree_rcu(meta, rcu);
-    }
